# IDP Platform Secrets Template
# ==============================
# Copy to secrets/<env>.env (e.g., secrets/minikube.env)
# DO NOT commit actual secrets to version control!
#
# Usage:
#   cp secrets/template.env secrets/minikube.env
#   # Edit secrets/minikube.env with your values
#   ./bootstrap.sh minikube

# ─────────────────────────────────────────────────────────────────
# REQUIRED: GitHub Token
# ─────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope
# Create at: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Dynatrace Credentials
# ─────────────────────────────────────────────────────────────────
# Leave empty to run without Dynatrace observability.
# Platform will use placeholder values and skip DT integration.

# Environment identifier (e.g., 'abc12345' from abc12345.live.dynatrace.com)
DT_ENV_NAME=

# Environment type: 'live', 'sprint', or 'dev'
DT_ENV=live

# Read-Write API token for generating other tokens
# Scopes: apiTokens.read, apiTokens.write
# Create at: Settings > Access tokens > Generate new token
DT_RW_API_TOKEN=

# OAuth credentials for business events and document APIs
# Create at: Settings > Access Tokens > OAuth clients
DT_OAUTH_CLIENT_ID=
DT_OAUTH_CLIENT_SECRET=
DT_OAUTH_ACCOUNT_URN=
