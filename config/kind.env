# Kind (Kubernetes in Docker) environment configuration
# Used by bootstrap.sh and Kustomize overlays

CLUSTER_TYPE=kind
CLUSTER_NAME=idp
BASE_DOMAIN=localhost

# Ports
ARGOCD_PORT=30100
BACKSTAGE_PORT=30105
DEMO_APP_PORT=80

# Git repository (update with your fork)
REPO_URL=https://github.com/Liquid-Reply/x-change-platform-engineering-demo.git
TARGET_REVISION=gh_codespace2k8s_opus_kustomize

# Optional: Dynatrace (leave empty to skip)
# DT_ENV_NAME=abc12345
# DT_ENV=live
