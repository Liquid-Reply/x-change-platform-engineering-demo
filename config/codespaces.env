# GitHub Codespaces environment configuration
# Used by bootstrap.sh and Kustomize overlays

CLUSTER_TYPE=kind
CLUSTER_NAME=kind
BASE_DOMAIN=${CODESPACE_NAME}

# Ports
ARGOCD_PORT=30100
BACKSTAGE_PORT=30105
DEMO_APP_PORT=80

# Codespaces port forwarding domain
GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=.app.github.dev

# Dynatrace (required for Codespaces - set via Codespace secrets)
# DT_ENV_NAME - from CODESPACE secret
# DT_ENV - from CODESPACE secret
# DT_RW_API_TOKEN - from CODESPACE secret
# DT_OAUTH_CLIENT_ID - from CODESPACE secret
# DT_OAUTH_CLIENT_SECRET - from CODESPACE secret
# DT_OAUTH_ACCOUNT_URN - from CODESPACE secret
