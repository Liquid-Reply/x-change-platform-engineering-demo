# Minikube Local Secrets Configuration
# ====================================
# Copy this file to 'secrets-minikube.yaml' and fill in your values.
# DO NOT commit secrets-minikube.yaml to version control!
#
# Usage:
#   cp secrets-minikube.yaml.example secrets-minikube.yaml
#   # Edit secrets-minikube.yaml with your values
#   python3 minikube_installer.py

# Dynatrace Configuration
# -----------------------
# Required for full observability features.
# Set to empty/remove if running without Dynatrace.
dynatrace:
  # Environment identifier (e.g., 'abc12345')
  env_name: ""

  # Environment type: 'live', 'sprint', or 'dev'
  env: "live"

  # Read-Write API token with scopes:
  # - apiTokens.read, apiTokens.write (for generating other tokens)
  rw_api_token: ""

  # OAuth credentials for business events
  # Create at: Settings > Access Tokens > OAuth clients
  oauth_client_id: ""
  oauth_client_secret: ""
  oauth_account_urn: ""

# GitHub Configuration
# --------------------
# Required for ArgoCD to access GitHub repositories.
github:
  # Personal Access Token with repo scope
  # Create at: GitHub > Settings > Developer settings > Personal access tokens
  token: ""

# Optional: Pre-generated Tokens
# ------------------------------
# If you have pre-generated tokens, you can provide them here.
# Otherwise, they will be generated from rw_api_token during installation.
#
# tokens:
#   # Token for data ingestion (logs, metrics, traces, events)
#   all_ingest_token: ""
#
#   # Token for OneAgent operator
#   operator_token: ""
#
#   # Token for Monaco configuration
#   monaco_token: ""
